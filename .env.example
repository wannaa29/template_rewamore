DEBUG=True
# Empty in development: a random secret is generated in var/.development-key.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,template.rewamore.my.id
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,https://template.rewamore.my.id
# Leave empty locally so links follow the actual host and port, or set your public base url:
PUBLIC_BASE_URL=https://template.rewamore.my.id
# SQLite is used when empty. PostgreSQL example:
# DATABASE_URL=postgresql://rewamore:replace-this-password@127.0.0.1:5432/rewamore
# Set to True when running behind Cloudflare Tunnel or a reverse proxy
TRUST_PROXY=True
