DEBUG=True
# Empty in development: a random secret is generated in var/.development-key.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Leave empty locally so links follow the actual host and port.
PUBLIC_BASE_URL=
# SQLite is used when empty. PostgreSQL example:
# DATABASE_URL=postgresql://rewamore:replace-this-password@127.0.0.1:5432/rewamore
TRUST_PROXY=False
