{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 60MB
    }
    handle_path /static/* {
        root * /srv/static
        header X-Content-Type-Options nosniff
        file_server
    }
    handle_path /media/* {
        root * /srv/media
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "default-src 'none'; sandbox"
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-For {remote_host}
        }
    }
}
